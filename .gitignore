# dependencies
node_modules/

# build output (regenerated by `npm run build` / the Publish button)
viz/dist/

# pipeline scratch files (inter-step handoffs; the dev-server Regenerate button deletes them,
# CLI runs leave them lying around — either way they never belong in git)
scripts/*-out.json
scripts/extras-mid.json

# live Azure inventory written by azure-gather.mjs: the real tenant's apps, registries and resource
# groups, which must never land in this public repo
azure-resources.json

# editor / OS
.idea/
.vscode/
.DS_Store

# transient screenshots / tool output
*.local.png
.playwright-mcp/
golden-path/exceptions.dev.jsonl
.env

# published static bundle — regenerated by bundle.mjs on every deploy (pages.yml/deploy.yml);
# the committed copy was a stale PLAINTEXT snapshot of the full data, undermining encrypt-data.mjs
published/
