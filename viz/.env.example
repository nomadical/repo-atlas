# Keycloak login — copy to viz/.env.local to enable the auth gate locally, or set these
# as GitHub Actions repo *variables* to enable it on the deployed site. Leave unset to run open
# (the default for local dev). All three must be present for the gate to activate. See infra/keycloak.md.
VITE_AUTH_SERVER_URL=https://id.example.com/
VITE_REALM=my-realm
VITE_RESOURCE=repo-atlas

# Role that unlocks the privileged controls (Settings/admin panel, Dev mode, Regenerate/Publish).
# Assign it on the Keycloak client (client role) or realm; the token must carry it. Defaults to
# `admin`. When auth is OFF (these vars unset, e.g. local dev) everyone is treated as admin.
VITE_ADMIN_ROLE=admin

# Token-gated data endpoint (fe-node-services /data). When set, the viz fetches data from here with
# the Keycloak bearer token instead of the encrypted bundle — so there's no passphrase gate. Falls
# back to data.enc if the endpoint is unreachable. Requires the server to allow this origin via CORS
# (see server/server.mjs CORS_ORIGINS). Leave empty to keep the passphrase model.
VITE_DATA_URL=https://architecture.example.com/repo-atlas/data
